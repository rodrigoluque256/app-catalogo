.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*

# Datos y logs locales
*.sqlite*
*.log

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Configuración local de Claude Code
.claude/settings.local.json
