APP_NAME="Catálogo"
APP_ENV=local
# Además de sesiones y cookies, cifra los secretos de 2FA del super panel: si se rota,
# hay que resetearlos con `php artisan platform:admin <email> --reset-2fa`.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=catalogo
DB_USERNAME=catalogo
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Desarrollo: Mailpit (servicio del compose) atrapa los emails; se ven en http://localhost:8025
# Producción (Resend, ver HANDOFF): MAIL_HOST=smtp.resend.com, MAIL_PORT=465, MAIL_SCHEME=smtps,
# MAIL_USERNAME=resend, MAIL_PASSWORD=<API key de Resend>, MAIL_FROM_ADDRESS=no-reply@<dominio verificado>
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@catalogo.test"
MAIL_FROM_NAME="${APP_NAME}"

# URL del panel para los links de los emails (invitaciones y reseteo de contraseña).
PANEL_URL=http://localhost:3000

# Cloudflare R2 (imágenes de productos y logos). Ver disco "r2" en config/filesystems.php.
# Credenciales: R2 > Manage API tokens (permiso Object Read & Write sobre el bucket).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Dominio público del bucket. Agregar su host a IMAGE_HOSTS del frontend.
# Desarrollo: la Public Development URL (https://pub-xxxx.r2.dev), con límite de tráfico y sin caché.
# Producción: un dominio propio conectado al bucket (ej. https://cdn.midominio.com). Se guarda la key,
# no la URL, así que cambiarlo no requiere migrar datos.
# El bucket necesita CORS que permita PUT (header content-type) desde el origen del panel.
R2_PUBLIC_URL=

VITE_APP_NAME="${APP_NAME}"

STOREFRONT_REVALIDATE_URL=http://frontend:3000/api/revalidate
STOREFRONT_REVALIDATE_SECRET=dev-secret
