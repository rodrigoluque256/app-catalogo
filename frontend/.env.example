# URL interna de la API Laravel (server-side; nunca se expone al navegador).
API_URL=http://localhost:8000
# Dominio raíz: demo.localhost:3000 -> tienda "demo" cuando ROOT_DOMAIN=localhost
ROOT_DOMAIN=localhost
# Debe coincidir con STOREFRONT_REVALIDATE_SECRET del backend.
REVALIDATE_SECRET=cambiar-esto
# Hosts de las imágenes de R2/CDN para next/image (separados por coma).
IMAGE_HOSTS=
# Solo desarrollo: hosts extra permitidos para el dev server de Next, separados por coma.
DEV_ORIGINS=
